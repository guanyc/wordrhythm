{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordrhythm",
  // Set this to today's date
  "compatibility_date": "2026-09-23",
  // The site is a static export; the Worker exists only for the verse URLs the
  // export cannot hold (anything that does not match an asset falls through to
  // it). See worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
